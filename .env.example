# Copy to .env and fill in secrets.

PLEX_URL=https://plex.obito.fr
# Plex token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=

TAUTULLI_URL=https://tautulli.melchior-50.obito.fr
# Tautulli > Settings > Web Interface > API key
TAUTULLI_API_KEY=

SEERR_URL=https://overseerr.obito.fr
# Seerr > Settings > General > API Key
SEERR_API_KEY=

# Optional: comma-separated Plex library names to include (default: all movie/show libraries)
# LIBRARIES=Movies,TV Shows,Animes

# Optional scoring tuning (defaults shown). Higher score = better deletion candidate.
# Score = sum of weight × factor. Size/age/inactivity factors are uncapped (e.g. 2 years idle = 2× weight).
# WEIGHT_LAST_ACTIVITY=30
# WEIGHT_WATCHES=20
# WEIGHT_VIEWERS=15
# WEIGHT_REQUEST=15
# WEIGHT_SIZE=10
# WEIGHT_AGE=10
# STALE_DAYS=365
# GRACE_DAYS=30
# SIZE_REF_GB=50
